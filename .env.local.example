# Local development configuration for hill90-app.
#
# `./scripts/local.sh up` generates a real `.env.local` from its own template if
# one does not exist, so you do not normally copy this file by hand. It is
# committed for two reasons:
#
#   1. A fresh clone can see what the stack needs without running anything.
#   2. `local.sh status` can diff a real `.env.local` against it and catch drift.
#      That check is what would have caught NETWORK_PREFIX going stale — the
#      generated template was fixed to `hill90dev`, but existing working
#      directories kept `hill90local` indefinitely and every `--infra` run failed
#      its preflight with no indication why.
#
# NO REAL SECRETS BELONG IN THIS FILE. Every value here is either a local-only
# placeholder or deliberately empty. The generated `.env.local` is gitignored and
# is where real values live; `local.sh` fills the random ones itself.

# --- database -----------------------------------------------------------------
# The app runs its own Postgres. It is NOT Hill90's: Hill90's platform Postgres
# asserts platform-only databases and its single role is `hill90` with a
# different password. See docs/decisions/running-the-app-on-hill90-infra.md.
DB_USER=hill90
DB_PASSWORD=hill90

# --- what production calls "the platform services" ----------------------------
# READ BY THE PRODUCTION COMPOSE FILES, which the tenant path layers on, so local
# needs them even though the names say "platform".
#
# They appeared when app-keycloak, app-postgres and app-minio were retired in
# PRODUCTION on 2026-07-30/31. Nothing supplied them locally, and Compose does not
# fail on an unset variable — it substitutes an empty string — so api, ai and
# knowledge were handed `postgresql://:@:5432/hill90_api`. Since #61 `ai` refuses
# to start without a database, so a clean `up` failed outright. `local.sh up` now
# runs the same interpolation gate deploy.sh does, and refuses rather than
# rendering a blank.
#
# THESE POINT AT THE APP'S OWN SERVICES. Locally "platform Postgres" is
# app-postgres and "platform MinIO" is app-minio. That restores how local worked
# before the cutover; it is NOT the parity conversion, which is still an open
# decision — docs/decisions/local-parity-with-platform-services.md.
PLATFORM_DB_HOST=app-postgres
PLATFORM_DB_USER=hill90
PLATFORM_DB_PASSWORD=hill90

# --- object storage -----------------------------------------------------------
MINIO_ROOT_USER=hill90admin
MINIO_ROOT_PASSWORD=hill90admin

# The production api compose reads ${MINIO_ENDPOINT:-http://minio:9000} — the
# PLATFORM container name. Locally there is no such container (Hill90's local
# stack does not start its MinIO), so this must be set or app-api points at
# nothing. The tenant credential is app-minio's root user locally, because the
# local MinIO has no scoped tenant user.
MINIO_ENDPOINT=http://app-minio:9000
MINIO_TENANT_ACCESS_KEY=hill90admin
MINIO_TENANT_SECRET_KEY=hill90admin

# --- identity -----------------------------------------------------------------
# The app runs its own Keycloak with realm `hill90`. Hill90's serves realm
# `platform` only, for infra admin SSO.
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=admin
AUTH_KEYCLOAK_ID=hill90-ui
AUTH_KEYCLOAK_SECRET=local-dev-secret

# --- shared service tokens ----------------------------------------------------
# `local.sh` generates a random value for each of these on first run. Left empty
# here on purpose: a committed placeholder that happened to work would be a
# credential shared by every clone.
AKM_INTERNAL_SERVICE_TOKEN=
MODEL_ROUTER_INTERNAL_SERVICE_TOKEN=
CHAT_CALLBACK_TOKEN=
PROVIDER_KEY_ENCRYPTION_KEY=
LITELLM_MASTER_KEY=
AUTH_SECRET=

# --- signing keys -------------------------------------------------------------
# Two Ed25519 keypairs, generated by `local.sh` into .local/ and inlined as
# PEM with escaped newlines. Nothing depends on any specific key material —
# tokens signed by an old key are worthless — so these are always freshly made.
AKM_SIGNING_PRIVATE_KEY=
MODEL_ROUTER_SIGNING_PRIVATE_KEY=

# --- model providers ----------------------------------------------------------
# Empty by default. The stack comes up without them; agent runs that call a model
# will fail until at least one is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- agentbox -----------------------------------------------------------------
# Absolute host path, because the API bind-mounts it into agent containers via
# the Docker socket, where a relative path would resolve on the wrong side.
# `local.sh` writes the real absolute path for this clone.
AGENTBOX_CONFIG_HOST_PATH=

# --- published ports ----------------------------------------------------------
# Used by the standalone path. Under `--infra` the Traefik hostnames below are
# the primary route and these keep working alongside them — except Postgres,
# which sits on an internal network where Docker cannot publish a port.
PORT_UI=13000
PORT_API=13001
PORT_LITELLM=14000
PORT_POSTGRES=15432
PORT_AI=18000
PORT_MCP=18001
PORT_KNOWLEDGE=18002
PORT_KEYCLOAK=18080
PORT_MINIO=19000
PORT_MINIO_CONSOLE=19001

# --- infra overlay (./scripts/local.sh up --infra) ----------------------------
# Ignored unless --infra is used. These must match the Hill90 infra repo's own
# .env.local, since both stacks have to agree on network names and hostnames.
# The values below are the infra repo's local values.
#
# NETWORK_PREFIX must match Hill90's exactly or the --infra preflight fails,
# naming the networks it could not find. Hill90 renamed this from `hill90local`
# to `hill90dev`; if an existing .env.local still says hill90local, that is the
# drift this file exists to catch.
NETWORK_PREFIX=hill90dev

# VOLUME_PREFIX is the third of the three parameterised names, and it was the
# one nobody set locally.
#
# The compose files declare volumes as ${VOLUME_PREFIX:-prod}_app-*, so with it
# unset the LOCAL stack created volumes called `prod_app-postgres-data`,
# `prod_app-minio-data` and `prod_app-akm-data` — production names, on a
# developer's machine. Verified on 2026-07-31 by reading the running local
# stack's mounts.
#
# CLAUDE.md invariant 3 says all three prefixes are parameterised, and invariant
# 4 singles volumes out as "the one that nearly caused data loss", because a
# byte-identical volume name mounts one stack's live database into another with
# no error and no warning. Two of the three prefixes were set locally and the
# third silently was not, which is exactly the drift those invariants exist to
# prevent.
#
# Changing this ORPHANS any existing prod_app-* volumes rather than migrating
# them. On a local stack that is the right trade — the data is disposable and
# recreated on `up` — but it does mean `./scripts/local.sh reset` before the
# first `up` after this lands, or you keep the old volumes lying around unused.
VOLUME_PREFIX=hill90dev

BASE_DOMAIN=localtest.me
HTTP_PORT=8080

# Hostnames the app claims through Hill90's Traefik. `localtest.me` resolves to
# 127.0.0.1, so no hosts entry is needed.
UI_HOST=app
API_HOST=api
AI_HOST=ai
STORAGE_HOST=storage

# The app's Keycloak hostname. Deliberately NOT `auth`: Hill90's own Keycloak
# owns auth.<domain> and serves realm `platform`, so the app asking for `auth`
# reached the wrong Keycloak and its realm 404'd.
APP_AUTH_HOST=app-auth

# AUTH_HOST is Hill90's Keycloak hostname, kept only so a value copied from
# Hill90's .env.local does not read as missing. The app does not route on it.
AUTH_HOST=auth

# Container name prefix, matching Hill90's convention: empty in production,
# set locally so two environments can coexist on one machine. App service names
# already carry an `app-` component, which is what keeps them distinct from
# Hill90's platform services within a single environment.
CONTAINER_PREFIX=hill90dev-
