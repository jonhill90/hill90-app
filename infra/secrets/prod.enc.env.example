# Example secrets store for hill90-app.
#
#   cp prod.enc.env.example prod.env      # fill in real values
#   sops -e prod.env > prod.enc.env       # encrypt
#   rm prod.env                           # never leave the plaintext behind
#
# NOTHING IN THIS FILE IS A REAL SECRET. Values are placeholders or empty.
# The encrypted prod.enc.env is committed; prod.env and keys/ are gitignored.
#
# What each group is for is documented in RESURRECTION.md §3, which is the only
# surviving description of the app's secret layout after extraction.

# --- database (the app's own postgres, not Hill90's) ---
DB_USER=hill90
DB_PASSWORD=REPLACE
DB_NAME=hill90

# --- object storage ---
MINIO_ROOT_USER=REPLACE
MINIO_ROOT_PASSWORD=REPLACE

# --- keycloak (the app's own realm `hill90`, not Hill90's `platform`) ---
KC_ADMIN_USERNAME=REPLACE
KC_ADMIN_PASSWORD=REPLACE
AUTH_KEYCLOAK_ID=hill90-ui
AUTH_KEYCLOAK_SECRET=REPLACE
AUTH_KEYCLOAK_ISSUER=https://app-auth.hill90.com/realms/hill90
AUTH_URL=https://hill90.com
AUTH_SECRET=REPLACE

# --- agent token signing (Ed25519) ---
# The API signs agent tokens with the private halves; ai and knowledge verify
# against the public halves mounted at /etc/akm. Nothing depends on the original
# key material — tokens signed by an old key are worthless — so generate fresh:
#   openssl genpkey -algorithm ed25519 -out akm-private.pem
# and inline the PEM with \n escapes.
AKM_SIGNING_PRIVATE_KEY=REPLACE
MODEL_ROUTER_SIGNING_PRIVATE_KEY=REPLACE

# --- shared service tokens (must match across api/ai/knowledge) ---
AKM_INTERNAL_SERVICE_TOKEN=REPLACE
MODEL_ROUTER_INTERNAL_SERVICE_TOKEN=REPLACE
CHAT_CALLBACK_TOKEN=REPLACE
PROVIDER_KEY_ENCRYPTION_KEY=REPLACE
LITELLM_MASTER_KEY=REPLACE

# --- model providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- services with no automated deploy (RESURRECTION.md §6) ---
DISCORD_BOT_TOKEN=

# --- deploy ---
# How .github/workflows/reusable-deploy-service.yml reaches the VPS. It is
# extracted with `sops -d --extract '["TAILSCALE_IP"]'` and masked in the log
# immediately, matching how Hill90 does it. The workflow fails with a named error
# if this key is absent rather than attempting to ssh to an empty host.
TAILSCALE_IP=REPLACE_WITH_VPS_TAILSCALE_IP

# --- tenancy ---
# Empty in production, matching Hill90's own convention. Set locally so two
# environments can coexist on one machine.
CONTAINER_PREFIX=
NETWORK_PREFIX=hill90
BASE_DOMAIN=hill90.com
APP_AUTH_HOST=app-auth
