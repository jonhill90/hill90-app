# Hill90 AgentBox Browser Profile
# Extends standard agentbox with Playwright + Chromium for web automation.
# Build after standard: docker build -f Dockerfile.browser -t hill90/agentbox-browser:latest .

FROM hill90/agentbox:latest

USER root

# Install Playwright system dependencies (Chromium)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright Python package + Chromium browser
RUN pip install --no-cache-dir playwright==1.49.1 && \
    PLAYWRIGHT_BROWSERS_PATH=/data/browsers playwright install chromium

# Ensure browser cache is owned by agentuser
RUN chown -R agentuser:agentuser /data/browsers

USER agentuser

ENV PLAYWRIGHT_BROWSERS_PATH=/data/browsers

# What commit produced this image (#228).
#
# Agent containers are created by services/api/src/services/docker.ts, not by
# compose, so they never receive the `com.hill90.revision` container label that
# deploy.sh stamps on every other container on the host. Until this existed,
# nothing could answer "what commit is this agent running" — and because the
# image is built by hand, that question has no other source.
#
# Defaults to `unstamped` rather than failing: a build that forgets the arg
# should still work and should SAY it is unknown, not claim a revision it does
# not have.
ARG GIT_REVISION=unstamped
LABEL com.hill90.revision=$GIT_REVISION
