{
  "realm": "platform",
  "enabled": true,
  "displayName": "Hill90 platform (local)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "verifyEmail": true,
  "loginTheme": "keycloak",
  "accountTheme": "keycloak",
  "adminTheme": "keycloak",
  "emailTheme": "keycloak",
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": false,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "PLATFORM admin. Grants Grafana Admin and OpenBao in production. NOT the app's admin role — nothing here should hold it."
      },
      {
        "name": "user",
        "description": "PLATFORM user. NOT the app's user role."
      }
    ],
    "client": {
      "hill90-ui": [
        {
          "name": "admin",
          "description": "App admin (client-scoped)"
        },
        {
          "name": "user",
          "description": "App user (client-scoped)"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "hill90-ui",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "redirectUris": [
        "http://localhost:13000/api/auth/callback/keycloak",
        "http://localhost:13000/*",
        "http://app.localtest.me:8080/api/auth/callback/keycloak",
        "http://app.localtest.me:8080/*"
      ],
      "webOrigins": [
        "http://localhost:13000",
        "http://app.localtest.me:8080"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "https://hill90.com/"
      },
      "protocolMappers": [
        {
          "name": "hill90-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "hill90-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "secret": "local-dev-secret",
      "bearerOnly": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "basic",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "hill90-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "bearerOnly": true,
      "description": "Resource server. Audience target only; never authenticates.",
      "fullScopeAllowed": true
    },
    {
      "clientId": "hill90-realm-admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "bearerOnly": false,
      "description": "app#500: service account for the api's own admin-user-management calls to Keycloak's admin API. Grants view-users + view-clients on realm-management only, never realm-admin. Not used by anything a browser touches.",
      "secret": "local-dev-realm-admin-secret",
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Local",
      "email": "dev@localhost",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "clientRoles": {
        "hill90-ui": [
          "user",
          "admin"
        ]
      }
    },
    {
      "username": "jon",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Jon",
      "lastName": "Hill",
      "email": "jon@localhost",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "clientRoles": {
        "hill90-ui": [
          "user",
          "admin"
        ]
      }
    },
    {
      "username": "hill90admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Hill90",
      "lastName": "Admin",
      "email": "hill90admin@localhost",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "clientRoles": {
        "hill90-ui": [
          "admin"
        ]
      }
    },
    {
      "username": "testuser01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User01",
      "email": "testuser01@localhost",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "clientRoles": {
        "hill90-ui": [
          "user"
        ]
      }
    },
    {
      "username": "service-account-hill90-realm-admin",
      "enabled": true,
      "serviceAccountClientId": "hill90-realm-admin",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "view-clients"
        ]
      }
    }
  ]
}
