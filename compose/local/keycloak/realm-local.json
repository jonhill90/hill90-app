{
  "realm": "hill90",
  "enabled": true,
  "displayName": "Hill90 (local)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "verifyEmail": true,
  "loginTheme": "keycloak",
  "accountTheme": "keycloak",
  "adminTheme": "keycloak",
  "emailTheme": "keycloak",
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": false,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "user"
      },
      {
        "name": "admin"
      }
    ],
    "client": {
      "hill90-ui": [
        {
          "name": "admin",
          "description": "App admin (client-scoped)"
        },
        {
          "name": "user",
          "description": "App user (client-scoped)"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "hill90-ui",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "redirectUris": [
        "http://localhost:13000/api/auth/callback/keycloak",
        "http://localhost:13000/*",
        "http://app.localtest.me:8080/api/auth/callback/keycloak",
        "http://app.localtest.me:8080/*"
      ],
      "webOrigins": [
        "http://localhost:13000",
        "http://app.localtest.me:8080"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "post.logout.redirect.uris": "https://hill90.com/"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_roles",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "hill90-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "hill90-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "secret": "local-dev-secret"
    },
    {
      "clientId": "hill90-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "emailVerified": true,
      "email": "dev@localhost",
      "firstName": "Local",
      "lastName": "Developer",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ],
      "clientRoles": {
        "hill90-ui": [
          "user",
          "admin"
        ]
      }
    }
  ]
}
