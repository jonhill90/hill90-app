# hill90-app Production Environment Variables
# Copy this to .env and fill in actual values.
#
# In Hill90 these came from OpenBao at runtime, with a SOPS-encrypted
# infra/secrets/prod.enc.env as the bootstrap fallback. Neither came with the
# app -- both are infrastructure. This file is now the only surviving
# description of what the application needs. See RESURRECTION.md section 3.

# Version
VERSION=latest

# Database
DB_USER=hill90
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DB_NAME=hill90

# JWT -- the API signs agent tokens with these. Regenerate them; the originals
# are in a vault this repo cannot reach, and tokens signed by them are worthless.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_PRIVATE_KEY=REPLACE_WITH_RSA_PRIVATE_KEY
JWT_PUBLIC_KEY=REPLACE_WITH_RSA_PUBLIC_KEY

# Model provider API keys
ANTHROPIC_API_KEY=sk-ant-REPLACE
OPENAI_API_KEY=sk-REPLACE

# Keycloak admin
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Auth.js / Keycloak integration
#
# The issuer is the APP's Keycloak, on app-auth.<domain>, serving realm hill90.
# It is deliberately NOT auth.<domain>: that is Hill90's Keycloak, which serves
# realm `platform` and is the identity provider for OpenBao, Grafana and
# Portainer SSO. Pointing the app there sends it to a Keycloak that 404s on its
# realm, and the two cannot share the hostname.
#
# These must agree with deploy/compose/prod/docker-compose.auth.yml, which uses
# ${APP_AUTH_HOST:-app-auth}.${BASE_DOMAIN:-hill90.com}. Re-point both for any
# new host, and update platform/auth/keycloak/hill90-realm.json to match.
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTH_KEYCLOAK_ID=hill90-ui
AUTH_KEYCLOAK_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
AUTH_KEYCLOAK_ISSUER=https://app-auth.hill90.com/realms/hill90
AUTH_URL=https://hill90.com

# MinIO object storage -- consumed by services/api (src/services/s3.ts),
# services/knowledge (web_page_fetcher.py), and services/ui
MINIO_ROOT_USER=REPLACE_WITH_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_PASSWORD

# Injected from the vault in Hill90, never present in this file:
#   DISCORD_BOT_TOKEN   services/discord-bot
#   TAVILY_API_KEY      web search tool
