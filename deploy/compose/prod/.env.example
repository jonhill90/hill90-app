# hill90-app Production Environment Variables
# Copy this to .env and fill in actual values.
#
# In Hill90 these came from OpenBao at runtime, with a SOPS-encrypted
# infra/secrets/prod.enc.env as the bootstrap fallback. Neither came with the
# app -- both are infrastructure. This file is now the only surviving
# description of what the application needs. See docs/reference/secret-layout.md.

# Version
VERSION=latest

# Database
# --- platform Postgres (the tenant login the platform provisions) -------------
# Consumed by api, ai, litellm and knowledge. Distinct from DB_USER/DB_PASSWORD
# below, which are app-postgres's own superuser and are still used by app-postgres
# and app-keycloak.
PLATFORM_DB_HOST=postgres
PLATFORM_DB_USER=hill90_app
PLATFORM_DB_PASSWORD=REPLACE_WITH_PLATFORM_TENANT_PASSWORD

DB_USER=hill90
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DB_NAME=hill90

# JWT -- the API signs agent tokens with these. Regenerate them; the originals
# are in a vault this repo cannot reach, and tokens signed by them are worthless.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_PRIVATE_KEY=REPLACE_WITH_RSA_PRIVATE_KEY
JWT_PUBLIC_KEY=REPLACE_WITH_RSA_PUBLIC_KEY

# Model provider API keys
ANTHROPIC_API_KEY=sk-ant-REPLACE
OPENAI_API_KEY=sk-REPLACE

# Keycloak admin
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Auth.js / Keycloak integration
#
# The issuer is HILL90'S Keycloak, on auth.<domain>, serving realm `platform`.
# It was app-auth.<domain>/realms/hill90 until 2026-07-30, when app-keycloak was
# retired. An example still naming app-auth would point a fresh deployment at a
# Keycloak that no longer exists — which is why this line is not just cosmetic.
# It is deliberately NOT auth.<domain>: that is Hill90's Keycloak, which serves
# realm `platform` and is the identity provider for OpenBao, Grafana and
# Portainer SSO. Pointing the app there sends it to a Keycloak that 404s on its
# realm, and the two cannot share the hostname.
#
# APP_AUTH_HOST and docker-compose.auth.yml are NOT dead, despite the production
# retirement: deploy/compose/overrides/local.{auth,api,ui}.yml still point LOCAL
# development at ${APP_AUTH_HOST:-app-auth}.${BASE_DOMAIN}. Local still runs the app's
# own Keycloak and still depends on it. Only PRODUCTION was retired on 2026-07-30, so
# do not delete the auth stack while local layers on it.
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTH_KEYCLOAK_ID=hill90-ui
AUTH_KEYCLOAK_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
AUTH_KEYCLOAK_ISSUER=https://auth.hill90.com/realms/platform
AUTH_URL=https://hill90.com

# MinIO object storage -- consumed by services/api (src/services/s3.ts),
# services/knowledge (web_page_fetcher.py), and services/ui
# --- Object storage ----------------------------------------------------------
# app-api now uses the PLATFORM MinIO (container `minio` on hill90_internal) with a
# credential scoped to the tenant's three buckets. Hill90's store is authoritative;
# these are a replica. MINIO_ROOT_* below belong to app-minio, which is retained but
# no longer the app's data path.
MINIO_TENANT_ACCESS_KEY=REPLACE_WITH_TENANT_ACCESS_KEY
MINIO_TENANT_SECRET_KEY=REPLACE_WITH_TENANT_SECRET_KEY

MINIO_ROOT_USER=REPLACE_WITH_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_PASSWORD

# Injected from the vault in Hill90, never present in this file:
#   DISCORD_BOT_TOKEN   services/discord-bot
#   TAVILY_API_KEY      web search tool
