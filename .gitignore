# macOS
.DS_Store
.DS_Store?

# Node
# No trailing slash, deliberately. `node_modules/` matches a DIRECTORY only, so
# it does not match a SYMLINK of the same name — git records that as mode 120000,
# a file. That gap let services/api/node_modules be committed as an absolute
# symlink into a contributor's home directory. The bare pattern matches both.
node_modules
coverage/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Next.js
.next/
out/
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
.venv/
venv/

# Environment — never commit real values; .env.example files are tracked
.env
.env.local
.env.*.local
.envrc

# Playwright
.playwright-cli/
.playwright-mcp/
tests/e2e/test-results/
tests/e2e/playwright-report/

# Editors
.vscode/
.idea/

# Per-agent git worktrees (git worktree add .worktrees/<branch> -b <branch>),
# so one Claude Code lane editing a branch cannot collide with another lane's
# uncommitted changes in the same shared checkout — the only thing that
# actually prevents it, since two processes editing one working tree can
# still stomp on each other regardless of how carefully each commits.
.worktrees/

# Local development stack (scripts/local.sh)
.env.local
.local/
compose/local/keys/

# App secrets: the age private key and any decrypted plaintext
infra/secrets/keys/
infra/secrets/*.env
!infra/secrets/*.enc.env
!infra/secrets/*.example

# carrier audit output (diagnostic, never committed)
services/api/carrier-audit.jsonl

# Written only when a test fails (issue #117 flake evidence); collected by CI, never committed.
test-artifacts/
